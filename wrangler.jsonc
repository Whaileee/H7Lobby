{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "h7-lobby",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // One Durable Object instance holds the whole game list (small: a few hundred games at most).
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  // SQLite-backed Durable Objects are the kind available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  "vars": {
    // "on": test that a registering host accepts TCP connections on its game port. Off: measured in game
    // (2026-11-05) the host listens on UDP 27015 only (no TCP listener in LAN mode), and Workers can't send UDP,
    // so the probe would report every host as unreachable. reachable is null while it is off.
    "PROBE": "off"
  }
}
